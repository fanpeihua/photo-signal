{
  "manifest_version": 3,
  "name": "取景 · 小红书本机采样",
  "version": "0.1.0",
  "description": "每两小时在本机读取摄影搜索卡片，数据只存当前浏览器。不会读取 Cookie 或发布互动。",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://www.xiaohongshu.com/*", "https://fanpeihua.github.io/*", "http://127.0.0.1:8840/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [
    {"matches": ["https://www.xiaohongshu.com/search_result*"], "js": ["content.js"], "run_at": "document_idle"},
    {"matches": ["https://fanpeihua.github.io/photo-signal/*", "http://127.0.0.1:8840/*"], "js": ["content.js"], "run_at": "document_idle"}
  ]
}
